{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demolay-portfolio-staff-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".output/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "12020261016", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": false },
  "vars": { "RELEASE_APPROVED": "false", "STAGING_REQUIRE_STAFF": "true" }
}
