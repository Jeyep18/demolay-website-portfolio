# Server configuration. Keep real values in ignored .env.local / Cloudflare secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
# The Supabase project origin is public and needed to build approved image URLs.
VITE_SUPABASE_URL=

# Admin Edge trial: local remains the default. Do not set edge until the hosted trial is approved.
ADMIN_API_MODE=local
# Dedicated server-to-server HMAC secret, at least 48 characters; never a service-role key.
ADMIN_EDGE_SECRET=
# Legacy anon JWT for the Supabase function gateway. Omit only if the publishable key above is already that JWT.
SUPABASE_GATEWAY_JWT=
