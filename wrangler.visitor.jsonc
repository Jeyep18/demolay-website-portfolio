{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demolay-portfolio-visitor-local",
  "main": "src/visitor-worker.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".output/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "observability": { "enabled": false }
}
